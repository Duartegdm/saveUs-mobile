# Backend .NET: login, cadastro e área do idoso (obrigatório).
EXPO_PUBLIC_API_URL=https://refugio-api-gs.eastus.cloudapp.azure.com

# Backend Java (refugio-service): área do gestor e Guia do Calor com IA.
# Sem esta variável o gestor usa o .NET e o Guia do Calor mostra só os cuidados fixos.
# Emulador Android: http://10.0.2.2:8080 | celular na mesma rede: http://<IP do PC>:8080
EXPO_PUBLIC_JAVA_API_URL=

# Opcional: força o commit exibido em "Sobre o App" (por padrão, git rev-parse HEAD no build).
EXPO_PUBLIC_COMMIT_HASH=
